# Copy to .env and adjust. Every value is optional; the defaults match docker-compose.yml.

# --- object storage (MinIO) ---
MINIO_ACCESS_KEY=traceflow
MINIO_SECRET_KEY=traceflow123
MINIO_BUCKET=traceflow-telemetry

# --- tail sampling defaults (persisted and editable from the Sampling page) ---
SAMPLING_ERROR_RATE=1.0
SAMPLING_SLOW_THRESHOLD_MS=500
SAMPLING_SUCCESS_RATE=0.1

# --- collector, when run outside Docker ---
# BUFFER_BACKEND=auto          # auto | redis | memory
# OBJECT_STORE_BACKEND=auto    # auto | minio | filesystem
# REDIS_URL=redis://localhost:6379/0
# MINIO_ENDPOINT=localhost:9000
# SQLITE_PATH=./data/traceflow.db

# --- simulated services, when run outside Docker ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8000
# ORDER_SERVICE_URL=http://localhost:8002
# PAYMENT_SERVICE_URL=http://localhost:8003
# INVENTORY_SERVICE_URL=http://localhost:8004
